    {
      "parameters": {
        "jsCode": "const j = $input.first()?.json ?? {};\nconst answer = j.output ?? j.response ?? j.text ?? j.answer ?? j.result;\nif (typeof answer !== 'string' || !answer.trim()) {\n  throw new Error('Q&A Chain returned no readable text. Inspect its Output to diagnose.');\n}\nreturn [{json:{output:answer}}];"
      },
