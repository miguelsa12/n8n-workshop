    {
      "parameters": {
        "jsCode": "const upload = $('Validate PDF and rename binary to data').first().json;\nreturn [{json:{status:'indexing_step_completed',file:upload.source,collection:'pcai_n8n_pdf_demo',next:'Open the test chat and ask about a fact in your PDF. Confirm it appears in Qdrant.'}}];"
      },
