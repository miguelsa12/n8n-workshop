{
  "name": "PCAI RAG — ALL IN ONE (Upload PDF + Test Chat + MLIS + Qdrant)",
  "nodes": [
    {
      "parameters": {
        "formTitle": "PCAI RAG — Upload PDF",
        "formDescription": "Choose a text-based PDF. The workflow will split, embed and index it in the dedicated Qdrant collection. Return to the n8n editor to check the execution.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "PDF document",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".pdf",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "aa08b757-8241-4e79-ad3d-21131c763422",
      "name": "UPLOAD PDF — n8n Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        64,
        336
      ],
      "webhookId": "bd58ae4b-2c5b-4732-8738-a8dd7660bae6"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (items.length !== 1) throw new Error('Please upload exactly one PDF per submission.');\nconst item = items[0];\nconst files = item.binary || {};\nconst keys = Object.keys(files);\nif (keys.length !== 1) throw new Error('No PDF binary found. Open UPLOAD PDF -> Output and inspect Binary.');\nconst pdf = files[keys[0]];\nconst filename = pdf.fileName || 'uploaded.pdf';\nconst mime = (pdf.mimeType || '').toLowerCase();\nif (!filename.toLowerCase().endsWith('.pdf') && mime !== 'application/pdf') {\n  throw new Error('Please upload a PDF document.');\n}\nreturn [{ json: { source: filename, uploaded_file_name: filename }, binary: { data: pdf } }];"
      },
      "id": "8ad0aa2f-d2b3-46aa-9f4b-e6b4c1e1ff3e",
      "name": "Validate PDF and rename binary to data",
      "type": "n8n-nodes-base.code",
